# Copy to .env and set values for your environment.
# Do not commit .env to version control.

# Auth API (e.g. login, refresh, user-info)
VITE_AUTH_API_BASE_URL=http://localhost:8083/api/v1/auth

# API Gateway (e.g. subscription plans, subscription requests)
VITE_API_GATEWAY_BASE_URL=http://localhost:8082/unihub

# Optional: request timeouts in milliseconds
# VITE_REQUEST_TIMEOUT_MS=30000
# VITE_AUTH_REQUEST_TIMEOUT_MS=10000


# VITE_ENABLE_LOGGING=false
